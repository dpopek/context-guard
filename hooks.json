{
  "context-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./hooks/pre_invocation.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|edit_file|write_file|replace_file_content|multi_replace_file_content|write_to_file|call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/pre_tool_use.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
