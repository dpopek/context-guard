#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Derive the root from the script location: git exports GIT_DIR to hooks in linked
# worktrees, which makes `rev-parse --show-toplevel` return the current directory.
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

STAGED="$(git diff --cached --name-only)"

if [[ -z "$STAGED" ]]; then
  exit 0
fi

# 1. If manifests (plugin.json / vscode-extension/package.json) are staged, both README.md and CHANGELOG.md must be staged.
if echo "$STAGED" | grep -Eq '^(plugin\.json|vscode-extension/package\.json)$'; then
  if ! echo "$STAGED" | grep -qx 'README.md' || ! echo "$STAGED" | grep -qx 'CHANGELOG.md'; then
    echo "[context-guard pre-commit] ERROR: Version/manifest changes require staging both README.md and CHANGELOG.md." >&2
    exit 1
  fi
fi

# 2. If production code/hooks/rules change, require README.md (or CHANGELOG.md) update unless ALLOW_NO_DOC_UPDATE=1.
if [[ "${ALLOW_NO_DOC_UPDATE:-0}" != "1" ]]; then
  if echo "$STAGED" | grep -Eq '^(spool/|evidence/|hooks/|bin/|policies/|integrations/|vscode-extension/.*\.js|hooks\.json|rules/)'; then
    if ! echo "$STAGED" | grep -Eq '^(README\.md|vscode-extension/README\.md|CHANGELOG\.md)$'; then
      echo "[context-guard pre-commit] ERROR: Production changes require updating README.md / CHANGELOG.md (or set ALLOW_NO_DOC_UPDATE=1 for internal-only refactors)." >&2
      exit 1
    fi
  fi
fi

# 3. Always run mechanical documentation sync, conciseness, module boundary & static type checks.
if echo "$STAGED" | grep -Eq '^vscode-extension/.*\.js$' && command -v node >/dev/null 2>&1; then
  for f in vscode-extension/*.js; do node --check "$f" || exit 1; done
fi
if command -v mypy >/dev/null 2>&1; then
  mypy spool evidence hooks bin policies integrations tests
fi
if command -v python3 >/dev/null 2>&1; then
  python3 -c "import sys; from bin.replay_benchmark import check_release_hygiene; issues = check_release_hygiene(); sys.exit('\n'.join(issues) if issues else 0)" || exit 1
else
  python -c "import sys; from bin.replay_benchmark import check_release_hygiene; issues = check_release_hygiene(); sys.exit('\n'.join(issues) if issues else 0)" || exit 1
fi
if command -v pytest >/dev/null 2>&1; then
  pytest -q tests/test_version_source.py tests/test_module_boundaries.py
elif command -v python3 >/dev/null 2>&1; then
  python3 -m pytest -q tests/test_version_source.py tests/test_module_boundaries.py
else
  python -m pytest -q tests/test_version_source.py tests/test_module_boundaries.py
fi
